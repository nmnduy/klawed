[Unit]
Description=FileSurf v2 Web Application (Quarkus JVM)
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/filesurf_v2

# Load environment file
EnvironmentFile=-/etc/filesurf/.env

# Run the Quarkus uber-jar with memory optimizations
ExecStart=/usr/bin/java \
    -Xmx256m \
    -Xms128m \
    -XX:+UseSerialGC \
    -XX:MaxMetaspaceSize=128m \
    -XX:+TieredCompilation \
    -XX:TieredStopAtLevel=1 \
    -Djava.net.preferIPv4Stack=true \
    -Dquarkus.profile=prod \
    -jar target/quarkus-app/quarkus-run.jar

Restart=always
RestartSec=10

# Environment variables
Environment="KLAWED_SANDBOX_IMAGE=klawed-sandbox:0.12.10"
Environment="KLAWED_AUTO_COMPACT=1"
Environment="KLAWED_USE_BEDROCK=1"
Environment="ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0"
Environment="AWS_REGION=us-west-2"

Environment="KLAWED_DISABLE_TOOLS=UploadImage"

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=filesurf-v2

[Install]
WantedBy=multi-user.target
