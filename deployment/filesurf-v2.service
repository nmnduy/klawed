[Unit]
Description=FileSurf v2 Web Application (Quarkus JVM)
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/filesurf_v2

# Load environment file
EnvironmentFile=-/etc/filesurf/.env

# JVM executable
ExecStart=/usr/bin/java \
    -Xmx256m \
    -Xms128m \
    -XX:+UseSerialGC \
    -XX:MaxMetaspaceSize=128m \
    -XX:+TieredCompilation \
    -XX:TieredStopAtLevel=1 \
    -Djava.net.preferIPv4Stack=true \
    -Dquarkus.profile=prod \
    -jar /root/filesurf_v2/target/quarkus-app/quarkus-run.jar

Restart=always
RestartSec=10

# Graceful shutdown configuration
# Send SIGTERM first, wait up to 60 seconds for graceful shutdown
# This allows @PreDestroy hooks to run and stop all Podman containers
KillSignal=SIGTERM
TimeoutStopSec=60

# Environment variables
Environment="JAVA_OPTS=-Xmx256m -Xms128m -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m"

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=filesurf-v2

[Install]
WantedBy=multi-user.target
