# Klawed Environment Variables for Local Development
#
# This file is used when running the application locally with podman sandbox enabled.
# Copy this file to .env (or another location) and set your actual values.
#
# To use this file, set the KLAWED_ENV_FILE environment variable:
#   export KLAWED_ENV_FILE=/path/to/your/.env
#
# For production deployment, use /etc/filesurf/klawed.env (default location)
#
# NOTE: For Stripe configuration, see .env.example and configure /etc/filesurf/.env
#       Stripe secrets are separate from Klawed agent configuration.

# =============================================================================
# AWS Bedrock Configuration (for Claude via AWS Bedrock)
# =============================================================================

# AWS Access Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
# AWS_SESSION_TOKEN=your_session_token_here  # Optional: only if using temporary credentials

# AWS Region where Bedrock is available
AWS_REGION=us-west-2

# =============================================================================
# Anthropic Configuration
# =============================================================================

# Anthropic API Key (if using direct Anthropic API instead of Bedrock)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude model to use
# For AWS Bedrock, use the Bedrock model ID format:
ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# For direct Anthropic API, use standard model names:
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# =============================================================================
# Klawed Configuration
# =============================================================================

# Use AWS Bedrock for Claude access (1=yes, 0=no)
# Set to 1 to use AWS Bedrock, 0 to use direct Anthropic API
KLAWED_USE_BEDROCK=1

# =============================================================================
# Optional: OpenAI Configuration
# =============================================================================

# OpenAI API Key (if using OpenAI models)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4
# OPENAI_API_BASE=https://api.openai.com/v1

# =============================================================================
# Optional: Proxy Configuration
# =============================================================================

# =============================================================================
# Klawed Configuration
# =============================================================================

# Disable image upload tool (not needed for most use cases)
KLAWED_DISABLE_TOOLS=UploadImage

# Enable automatic memory compaction
KLAWED_AUTO_COMPACT=1

# =============================================================================
# Optional: Proxy Configuration
# =============================================================================

# HTTP/HTTPS proxy settings (uncomment if needed)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
