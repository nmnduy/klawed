# =============================================================================
# FileSurf v2 Environment Configuration
# =============================================================================
# 
# This file contains application-level environment variables for FileSurf v2.
# Copy this file to .env.local for local development, or configure manually
# for production deployment.
#
# For local development: Copy to .env.local in the project root
# For production:       Configure values in /etc/filesurf/.env
#
# NOTE: This file is for application secrets (Stripe, etc.). For Klawed agent
# configuration, see .klawed.env.example
#
# =============================================================================

# =============================================================================
# Stripe Configuration (for payment processing)
# =============================================================================
# Get API keys from https://dashboard.stripe.com/apikeys
# Get webhook secret from https://dashboard.stripe.com/webhooks
# Create products and prices at https://dashboard.stripe.com/products

# Stripe API Keys (use test keys for development, live keys for production)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# Stripe webhook secret (for verifying webhook signatures)
# Get from Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (created in Stripe Dashboard for subscription plans)
STRIPE_PRICE_BASIC=price_your_basic_plan_id
STRIPE_PRICE_PRO=price_your_pro_plan_id

# =============================================================================
# Application Configuration
# =============================================================================

# Application base URL (for Stripe redirects and webhook endpoints)
# Local development: http://localhost:9090
# Production:       https://filesurf.io
APP_BASE_URL=https://filesurf.io

# =============================================================================
# Database Configuration (optional overrides)
# =============================================================================

# SQLite database path (default: data/filesurf.db)
# QUARKUS_DATASOURCE_JDBC_URL=jdbc:sqlite:./data/filesurf.db
