#!/bin/bash
#
# Source CI environment (Telegram tokens etc.)
if [ -f /home/git/repos/klawed.git/hooks/post-receive.env ]; then
  . /home/git/repos/klawed.git/hooks/post-receive.env
fi
#
# Post-receive hook for the registry server (registry.kasafox.com:/home/git/repos/klawed.git)
#
# On every push to master, this hook:
#   1. Checks out the repo to a temp working directory
#   2. Builds and runs tests
#   3. On success: bumps the patch version, commits, and tags
#   4. Sends Telegram notifications for each stage
#
# The tag is created directly in the bare repo, so subsequent clones/fetches
# from the registry server will see the new tag.
#
# Installation (run as root on registry.kasafox.com):
#   cp scripts/registry-post-receive /home/git/repos/klawed.git/hooks/post-receive
#   chmod +x /home/git/repos/klawed.git/hooks/post-receive
#   apt-get install libcurl4-openssl-dev libcjson-dev libbsd-dev libsqlite3-dev libncursesw5-dev libssl-dev
#
# Environment variables (set on registry server or in hook):
#   ALERT_BOT_TOKEN  - Telegram bot token
#   ALERT_CHAT_ID    - Telegram chat ID for notifications

set -euo pipefail

# ── Telegram notification ──────────────────────────────────────────────
TELEGRAM_API="https://api.telegram.org"
BOT_TOKEN="${ALERT_BOT_TOKEN:-}"
CHAT_ID="${ALERT_CHAT_ID:-}"

notify_telegram() {
    local text="$1"
    if [ -z "$BOT_TOKEN" ] || [ -z "$CHAT_ID" ]; then
        return 0  # silently skip if not configured
    fi
    curl -s -X POST "${TELEGRAM_API}/bot${BOT_TOKEN}/sendMessage" \
        -d "chat_id=${CHAT_ID}" \
        -d "text=${text}" \
        -d "parse_mode=HTML" \
        -o /dev/null 2>/dev/null || true
}

notify_ok()  { notify_telegram "✅ <b>$1</b>"; }
notify_err() { notify_telegram "❌ <b>$1</b>"; }
notify_info() { notify_telegram "ℹ️ $1"; }
# ───────────────────────────────────────────────────────────────────────

# Only act on master branch pushes
BRANCH=""
while read -r oldrev newrev refname; do
    case "$refname" in
        refs/heads/master)
            BRANCH="master"
            NEWREV="$newrev"
            ;;
    esac
done

if [ "$BRANCH" != "master" ]; then
    exit 0
fi

echo "[registry-ci] Push to master detected ($NEWREV)"

# Skip version bump commits to avoid infinite recursion
COMMIT_MSG=$(git --git-dir="$(pwd)" log -1 --pretty=%s "$NEWREV")
if echo "$COMMIT_MSG" | grep -q "^chore: bump version to"; then
    echo "[registry-ci] Skipping — this is a version bump commit (pushed by CI)"
    exit 0
fi

COMMIT_AUTHOR=$(git --git-dir="$(pwd)" log -1 --pretty=%an "$NEWREV")
SHORT_HASH=$(echo "$NEWREV" | cut -c1-8)
notify_info "🔧 klawed CI started for <code>${SHORT_HASH}</code> by ${COMMIT_AUTHOR}&#10;<i>${COMMIT_MSG}</i>"

# Create temp working directory and log files
WORKDIR=$(mktemp -d /tmp/klawed-ci-XXXXXX)
BUILD_LOG=$(mktemp /tmp/klawed-build-XXXXXX.log)
TEST_LOG=$(mktemp /tmp/klawed-test-XXXXXX.log)
trap 'rm -rf "$WORKDIR"; rm -f "$BUILD_LOG" "$TEST_LOG"' EXIT

echo "[registry-ci] Cloning to $WORKDIR..."
git clone "$(pwd)" "$WORKDIR"
cd "$WORKDIR"
# Git hooks export GIT_DIR=. which breaks commands after we cd into
# the non-bare clone. Unset it so git uses the .git/ directory normally.
unset GIT_DIR
git checkout "$NEWREV"
echo "[registry-ci] Building..."
if make 2>&1 | tail -20 > "$BUILD_LOG"; then
    echo "[registry-ci] Build passed"
    notify_ok "klawed CI: Build passed for <code>${SHORT_HASH}</code>"
else
    echo "[registry-ci] Build FAILED"
    BUILD_TAIL=$(tail -5 "$BUILD_LOG" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')
    notify_err "klawed CI: Build <b>FAILED</b> for <code>${SHORT_HASH}</code>&#10;<pre>${BUILD_TAIL}</pre>"
    rm -f "$BUILD_LOG"
    exit 1
fi
rm -f "$BUILD_LOG"

echo "[registry-ci] Running tests..."
# Set TERM so ncurses-based tests don't fail in non-TTY CI environment
export TERM=xterm-256color
# Run all tests with -k (keep going) so one failure doesn't skip remaining tests
make -k \
    test-arena \
    test-arena \
    test-array-resize \
    test-base64 \
    test-config \
    test-config-merge \
    test-redact \
    test-wrap \
    test-edit \
    test-http-client \
    test-json-parsing \
    test-markdown-render \
    test-line-printer \
    test-code-block-fill \
    test-dump-utils \
    test-todo \
    test-todo-write \
    test-model-capabilities \
    test-paste \
    test-paste-placeholder \
    test-memory-null-fix \
    test-rotation \
    test-message-queue \
    test-bash-timeout \
    test-bash-stderr \
    test-bash-truncation \
    test-cancel-flow \
    test-tool-results-regression \
    test-history-file \
    test-tui-input-buffer \
    test-tui-auto-scroll \
    test-tool-details \
    test-token-usage \
    test-token-usage-comprehensive \
    test-token-usage-session-totals \
    test-token-usage-db-metadata \
    test-sqlite-queue-seeding \
    test-file-search \
    test-provider-init-from-config \
    test-provider-init \
    test-session-resolve \
    test-codex-tools \
    test-tool-disable \
    > "$TEST_LOG" 2>&1
# Check log for actual test failures (make -k always exits non-zero on failure,
# but we want to continue running all tests before checking results)
if grep -qE '(^make: .*Error)|(FAIL$)|(FAILED$)|(✗.*FAIL)|Aborted|Segmentation fault' "$TEST_LOG"; then
    echo "[registry-ci] Tests FAILED"
    FAIL_COUNT=$(grep -c 'FAIL\|FAILED\|failed\|Error' "$TEST_LOG" 2>/dev/null || echo "?")
    TEST_TAIL=$(tail -5 "$TEST_LOG" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')
    notify_err "klawed CI: Tests <b>FAILED</b> for <code>${SHORT_HASH}</code> (${FAIL_COUNT} failures)&#10;<pre>${TEST_TAIL}</pre>"
    exit 1
fi
echo "[registry-ci] All tests passed"

echo "[registry-ci] All tests passed. Bumping patch version..."

CURRENT_VERSION=$(cat VERSION)
VERSION_MAJOR=$(echo "$CURRENT_VERSION" | sed 's/^\([0-9]*\)\..*/\1/')
VERSION_MINOR=$(echo "$CURRENT_VERSION" | sed 's/^[0-9]*\.\([0-9]*\)\..*/\1/')
VERSION_PATCH=$(echo "$CURRENT_VERSION" | sed 's/^[0-9]*\.[0-9]*\.\([0-9]*\).*/\1/')
NEW_PATCH=$((VERSION_PATCH + 1))
NEW_VERSION="$VERSION_MAJOR.$VERSION_MINOR.$NEW_PATCH"

echo "[registry-ci] $CURRENT_VERSION → $NEW_VERSION"

# Check if this tag already exists (another CI run may have beaten us)
if git tag -l "v$NEW_VERSION" | grep -q .; then
    echo "[registry-ci] Tag v$NEW_VERSION already exists — skipping (already bumped by another run)"
    notify_info "klawed CI: Tag v${NEW_VERSION} already exists — skipping bump"
    exit 0
fi

echo "$NEW_VERSION" > VERSION
rm -f src/version.h
make src/version.h

# Update README.md clone command
sed -i.bak "s/git clone --branch v[0-9]*\.[0-9]*\.[0-9]*/git clone --branch v$NEW_VERSION/g" README.md
rm -f README.md.bak

git config user.name "registry-ci"
git config user.email "ci@registry.kasafox.com"
git add VERSION src/version.h README.md
git commit -m "chore: bump version to $NEW_VERSION"
git tag -a "v$NEW_VERSION" -m "Release v$NEW_VERSION"

echo "[registry-ci] Pushing version bump and tag back to registry..."
# Push bump commit to master (HEAD is detached, so push explicitly)
git push origin HEAD:refs/heads/master
git push origin "v$NEW_VERSION"

echo "[registry-ci] Done — tagged v$NEW_VERSION"
notify_ok "klawed CI: <b>v${NEW_VERSION}</b> tagged and pushed&#10;<code>${SHORT_HASH}</code> → ${CURRENT_VERSION} → ${NEW_VERSION}"
